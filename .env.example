# Environment Variables for AARSH Portal

# Google Sheets Configuration
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Optional: API Keys for advanced features
# IBBI_API_KEY=your_ibbi_api_key_here

# Optional: require this value in the x-admin-token header for POST /api/manual-update
# ADMIN_TOKEN=choose_a_long_random_value

# Optional: verify IBBI's TLS certificate (off by default, see scrapers/ibbi_scraper.js)
# IBBI_STRICT_TLS=1

# Optional: port for the web server (default 3001)
# PORT=3001
